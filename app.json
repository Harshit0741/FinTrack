{
  "expo": {
    "name": "FinTrack",
    "slug": "fintrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/13.png",
    "scheme": "fintrack",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.harshit122.fintrack",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/13.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/13.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA"
      ],
      "package": "com.harshit122.fintrack"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/13.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-13.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FinTrack to access your photos to set a profile picture or scan a receipt.",
          "cameraPermission": "Allow FinTrack to access your camera to scan receipts."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow FinTrack to access your microphone to log transactions by voice."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow FinTrack to access your camera to scan receipts."
        }
      ],
      "expo-asset",
      "@clerk/expo"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4f9fa95b-1aa3-4af8-ad46-d2d0855fb05f"
      }
    }
  }
}
